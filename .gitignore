# ═══════════════════════════════════════════════════════════
#  SmVnc - Git Ignore Rules
#  Author : Sazid Mehmud (t.me/SmMehmudTg18)
#  Repo   : github.com/MehmudHub/SmVnc
# ═══════════════════════════════════════════════════════════

# ─── 🚫 USER DATA (কখনো পুশ হবে না) ───
# data/ এর বদলে data/* ব্যবহার করা হয়েছে যাতে !data/.gitkeep কাজ করে
data/*
!data/.gitkeep

# ─── 🚫 LOGS ───
logs/*
!logs/.gitkeep
*.log
*.log.*

# ─── 🚫 LOCAL CONFIG (প্রত্যেক মেশিনে আলাদা) ───
config/users.conf
config/*.local
config/*.bak
!config/users.conf.example

# ─── 🚫 SECRETS & ENV (কখনো পুশ করবে না!) ───
.env
.env.*
!.env.example
*.key
*.pem
*.crt
*.p12
secrets/
credentials/
*.password
*_rsa
*_ed25519
id_rsa*
id_ed25519*

# ─── 🚫 RUNTIME FILES ───
*.pid
*.lock
*.socket
*.sock
*.tmp
*.temp
*.swp
*.swo
*.bak
*.old
*.orig
.run/
.pid/

# ─── 🚫 BUILD ARTIFACTS ───
*.tar
*.tar.gz
*.zip
*.img
*.qcow2
dist/
build/
out/

# ─── 🚫 ARCHIVES ───
*.7z
*.rar
*.gz
*.bz2
*.xz
*.tgz

# ─── 🚫 BACKUP FILES ───
*.backup
*_backup/
*_old/
backup/
bkp/

# ─── 🚫 OS GENERATED FILES ───
# macOS
.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes

# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
*.lnk

# Linux
.directory
.Trash-*
*.kate-swp
*~

# ─── 🚫 IDE / EDITOR FILES ───
# VS Code
.vscode/
!.vscode/extensions.json

# JetBrains
.idea/
*.iml
*.ipr
*.iws

# Vim
*.vim
.viminfo
.vim/

# Nano
*.save

# Sublime Text
*.sublime-project
*.sublime-workspace

# ─── 🚫 PYTHON (ভবিষ্যতের জন্য) ───
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
*.egg-info/
.installed.cfg
*.egg
.venv/
venv/
ENV/
env/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.tox/
.coverage
htmlcov/

# ─── 🚫 NODE.JS (ভবিষ্যতে Web GUI বানালে) ───
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
.npm
.yarn/

# ─── 🚫 CACHE ───
.cache/
*.cache

# ─── 🚫 TEST FILES ───
test/
tests/
*.test
*.spec

# ═══════════════════════════════════════════════════════════
# ✅ KEEP THESE (ফাঁকা ফোল্ডার Git-এ ট্র্যাক করতে)
# ═══════════════════════════════════════════════════════════
!data/.gitkeep
!logs/.gitkeep
